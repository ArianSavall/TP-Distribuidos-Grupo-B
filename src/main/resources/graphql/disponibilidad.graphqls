type Query {
    vehiculosDisponibles(
        tipo: TipoVehiculo
        marca: String
        modelo: String
        precioMin: Float
        precioMax: Float
        fechaInicio: String!
        fechaFinal: String!
    ): [VehiculoDisponible!]!
}

type VehiculoDisponible {
    patente: String!
    marca: String!
    modelo: String!
    anio: Int!
    color: String
    tipoVehiculo: TipoVehiculo!
    precioDiario: Float!
}

enum TipoVehiculo {
    SEDAN
    SUV
    PICKUP
    COUPE
    HATCHBACK
}